# ==========================================================================
# SkinTypeAI - environment configuration
#
# Copy this file to ".env" (same folder) and edit the values you need.
# Every key here maps 1:1 to a field in backend/app/core/config.py::Settings
# (pydantic-settings, case-insensitive). Anything left unset uses the code
# default shown in the comment.
#
# The real .env is git-ignored. NEVER commit secrets.
# ==========================================================================

# ---- Auth -----------------------------------------------------------------
# JWT signing key. The default ("dev-secret-change-me") is for local dev ONLY.
# Generate a strong value for any shared / deployed instance, e.g.:
#     python -c "import secrets; print(secrets.token_urlsafe(48))"
# Changing this invalidates every existing token (users must log in again).
JWT_SECRET_KEY=dev-secret-change-me
# JWT_ALGORITHM=HS256
# ACCESS_TOKEN_EXPIRE_MINUTES=1440        # 60*24 = 1 day

# ---- Database -----------------------------------------------------------------
# Default: a local SQLite file at database/skintype.db (created by
# database/init_db.py). Point at Postgres for a real deployment, e.g.:
#     DATABASE_URL=postgresql+psycopg://user:pass@host:5432/skintypeai
# DATABASE_URL=sqlite:///./database/skintype.db

# ---- Uploads -----------------------------------------------------------------
# UPLOAD_DIR=backend/uploads              # face photos are written here
# MAX_UPLOAD_SIZE_MB=10

# ---- ML runtime -----------------------------------------------------------------
# ML_DEVICE=cpu                           # "cpu" or "cuda"
# ML_TORCH_THREADS=4

# ---- Custom multi-task model (trained by this project) ------------------------
# When true AND the checkpoint exists, skin_type / dryness / oiliness /
# acne-severity / pigmentation come from weights/custom_skin_model.pt
# (built by scripts/prepare_dataset.py + training/train_custom.py).
# Set to false to force the Hugging Face ViT fallback path.
# USE_CUSTOM_MODEL=true
# CUSTOM_MODEL_WEIGHTS_PATH=weights/custom_skin_model.pt

# ---- Fallback / other model knobs (rarely changed) --------------------------
# ACNE_DETECTOR_CONF=0.25                 # YOLO acne-box confidence threshold
# ACNE_DETECTOR_IOU=0.45
# ACNE_DETECTOR_IMGSZ=640
# WRINKLE_ENABLED=true                    # CC BY-NC-SA weights - academic use only
# WRINKLE_THRESHOLD=0.5
# HEURISTICS_ENABLED=true                 # redness + enlarged-pores estimates

# ---- Legacy (kept for rollback only; not on the active path) ----------------
# yolo_conf_threshold was previously lowered to 0.05 for the under-trained CPU
# proof YOLO. The active acne detector uses ACNE_DETECTOR_CONF above instead.
# YOLO_CONF_THRESHOLD=0.25
